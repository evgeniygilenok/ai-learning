# Real model and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangGraph Postgres checkpointer and Qdrant vector store
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent_course
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulated_support_chunks

# One hosted OTLP/HTTP backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# MCP server-owned identity and authority
MCP_TENANT_ID=demo-bank
MCP_SCOPES=transfers:read
MCP_WRITE_MODE=disabled
