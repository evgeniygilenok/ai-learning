# Real model and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Four-week practice route. Real mode requires a reviewed model and prices above/below.
PRACTICE_PROVIDER=fake
PRACTICE_DB=starter/.practice/course.sqlite
PRACTICE_SCOPES=transfers:read,escalations:draft
PRACTICE_MAX_CALLS=6
PRACTICE_MAX_ATTEMPTS=3
PRACTICE_BATCH_SIZE=5
PRACTICE_SPEND_USD=
PRACTICE_INPUT_USD_PER_MILLION=
PRACTICE_OUTPUT_USD_PER_MILLION=

# LangGraph Postgres checkpointer and Qdrant vector store
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent_course
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=regulated_support_chunks

# One hosted OTLP/HTTP backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# MCP server-owned identity and authority
MCP_TENANT_ID=demo-bank
MCP_SCOPES=transfers:read
MCP_WRITE_MODE=disabled
