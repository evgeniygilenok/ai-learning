  "ci": {
    "pullRequestSuites": ["critical-deterministic", "matched-benign"],
    "releaseSuites": ["critical-deterministic", "goal-integrity", "matched-benign"],
    "onMalformedConfig": "fail",
    "onUnresolvedPlaceholder": "fail",
    "onMissingResult": "fail",
    "onPinDrift": "fail",
    "onScorerUnavailable": "fail",
    "retainRedactedFailures": true
