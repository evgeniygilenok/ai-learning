  "reporting": {
    "requiredMetrics": [
      "utilitySuccessRate",
      "attackSuccessRate",
      "unsafeEffectRate",
      "canaryLeakRate",
      "authorizationIsolationViolationRate",
      "unsafeProposalRate",
      "goalIntegrityRate",
